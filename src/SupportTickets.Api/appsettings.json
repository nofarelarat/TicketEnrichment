{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Tickets": "Data Source=tickets.db"
  },
  "Enrichment": {
    "WorkerEnabled": true,
    "PollInterval": "00:00:02",
    "BatchSize": 20,
    "AttemptTimeout": "00:00:10",
    "MaxAttempts": 5,
    "BaseRetryDelay": "00:00:02",
    "MaxRetryDelay": "00:05:00",
    "JitterFactor": 0.2,
    "Mock": {
      "FailureMode": "None",
      "FailuresBeforeSuccess": null,
      "RateLimitRetryAfter": "00:00:30"
    }
  }
}

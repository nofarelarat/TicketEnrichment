{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Tickets": "Data Source=tickets.db"
  },
  "Enrichment": {
    "Provider": "Mock",
    "WorkerEnabled": true,
    "PollInterval": "00:00:00.500",
    "BatchSize": 20,
    "AttemptTimeout": "00:00:10",
    "MaxAttempts": 5,
    "BaseRetryDelay": "00:00:02",
    "MaxRetryDelay": "00:05:00",
    "JitterFactor": 0.2,
    "Claude": {
      "Model": "claude-opus-5-5",
      "MaxTokens": 1024
    },
    "Mock": {
      "FailureMode": "None",
      "FailuresBeforeSuccess": null,
      "RateLimitRetryAfter": "00:00:30"
    }
  }
}
